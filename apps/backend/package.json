{
  "name": "@zayaluxe/backend",
  "version": "0.0.0",
  "private": true,
  "description": "Zaya Luxe commerce backend — Medusa v2 (Qatar region, QAR, COD + hosted gateway)",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "medusa develop",
    "build": "medusa build",
    "start": "medusa start",
    "seed": "medusa exec ./src/scripts/seed.ts",
    "db:migrate": "medusa db:migrate",
    "db:generate": "medusa db:generate",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "test": "jest --passWithNoTests",
    "test:unit": "TEST_TYPE=unit jest --passWithNoTests",
    "test:integration:http": "TEST_TYPE=integration:http jest --runInBand --forceExit --passWithNoTests",
    "test:integration:modules": "TEST_TYPE=integration:modules jest --runInBand --forceExit --passWithNoTests"
  },
  "dependencies": {
    "@medusajs/admin-sdk": "2.22.1",
    "@medusajs/cache-redis": "2.22.1",
    "@medusajs/cli": "2.22.1",
    "@medusajs/draft-order": "2.22.1",
    "@medusajs/event-bus-redis": "2.22.1",
    "@medusajs/file-s3": "2.22.1",
    "@medusajs/framework": "2.22.1",
    "@medusajs/locking-redis": "2.22.1",
    "@medusajs/medusa": "2.22.1",
    "@medusajs/workflow-engine-redis": "2.22.1",
    "awilix": "^8.0.1",
    "ioredis": "^5.4.1",
    "pg": "^8.13.1",
    "posthog-node": "^5.11.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@medusajs/test-utils": "2.22.1",
    "@swc/core": "^1.10.7",
    "@swc/jest": "^0.2.37",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "jest": "^29.7.0",
    "ts-node": "^10.9.2",
    "typescript": "5.9.3",
    "vite": "^6.0.7",
    "yalc": "^1.0.0-pre.53"
  },
  "engines": {
    "node": ">=22.22.0"
  }
}
