# ─────────────────────────────────────────────────────────────
# Zaya Luxe — environment reference
# Copy to the app-level file you need; never commit a real .env.
#   apps/backend/.env      (loadEnv reads .env.development / .env.production)
#   apps/storefront/.env.local
# Owners and rotation steps: docs/runbooks/secrets.md
# ─────────────────────────────────────────────────────────────

# ── Backend: core ────────────────────────────────────────────
NODE_ENV=development
PORT=9000
DATABASE_URL=postgres://zaya:zaya@localhost:5432/zayaluxe
REDIS_URL=redis://localhost:6379
JWT_SECRET=replace-me
COOKIE_SECRET=replace-me
STORE_CORS=http://localhost:8000
ADMIN_CORS=http://localhost:9000,http://localhost:7001
AUTH_CORS=http://localhost:8000,http://localhost:9000

# ── Backend: media (Cloudflare R2 / S3-compatible) ───────────
S3_FILE_URL=
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── Backend: search ──────────────────────────────────────────
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=local-dev-master-key
MEILISEARCH_PUBLIC_KEY=

# ── Backend: payments (client-selected gateway — see payments.md) ──
PAYMENT_PROVIDER=stub          # stub | tap | myfatoorah | paytabs | qnbqpay
PAYMENT_SANDBOX=true
PAYMENT_MERCHANT_ID=
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=
COD_ENABLED=true
COD_MAX_ORDER_VALUE=3000       # QAR, integer minor units applied in code
COD_OTP_REQUIRED=true

# ── Backend: email ───────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=orders@zayaluxe.co
EMAIL_REPLY_TO=support@zayaluxe.co

# ── Backend: observability ───────────────────────────────────
SENTRY_DSN=

# ── Storefront ───────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:8000
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_replace_me
NEXT_PUBLIC_DEFAULT_REGION=qa
NEXT_PUBLIC_DEFAULT_LOCALE=en
REVALIDATE_SECRET=replace-me
MEILISEARCH_SEARCH_KEY=

# ── Analytics / marketing (feature-flagged, off by default) ──
NEXT_PUBLIC_GA4_ID=
META_PIXEL_ID=
META_CAPI_TOKEN=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
NEXT_PUBLIC_SNAP_PIXEL_ID=
